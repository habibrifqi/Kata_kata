// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Note: Prisma v7+ — connection URLs are configured in prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enum: Role
// Tiga tingkatan akses user dalam sistem
// ============================================================
enum Role {
  writer
  admin
  superadmin
}

// ============================================================
// Model: User
// Pemilik author, diautentikasi via Google OAuth
// 1 User bisa punya banyak Author
// ============================================================
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  image     String?  // Avatar URL dari Google
  role      Role     @default(writer)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authors   Author[]
  favorites UserFavorite[]

  @@map("users")
}

// ============================================================
// Model: Author
// Penulis / tokoh inspiratif dibalik kutipan
// Berelasi ke User (nullable) dan bisa dipakai di Quote
// ============================================================
model Author {
  id          Int      @id @default(autoincrement())
  name        String
  title       String?
  bio         String?
  avatarUrl   String?
  tags        String[]
  quotesCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi ke User (nullable - 1 user bisa punya banyak author)
  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relasi ke Quote (1 author bisa punya banyak quote)
  quotes Quote[]

  @@map("authors")
}

// ============================================================
// Model: Category
// Menyimpan kategori kata-kata / kutipan
// ============================================================
model Category {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  colorBg     String          @default("bg-primary")
  glowColor   String          @default("rgba(192, 193, 255, 0.6)")
  quotesCount Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  quotes      QuoteCategory[]

  @@map("categories")
}

// ============================================================
// Model: Quote
// Menyimpan kutipan / kata-kata inspiratif
// 1 Quote dimiliki oleh 1 Author (nullable)
// ============================================================
model Quote {
  id         Int             @id @default(autoincrement())
  text       String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  // Relasi ke Author (nullable — 1 author bisa punya banyak quote)
  authorId     Int?
  author       Author?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // Relasi ke Category (many-to-many — category bersifat global)
  categories QuoteCategory[]
  favorites  UserFavorite[]

  @@map("quotes")
}

// Quote favorit milik masing-masing user.
model UserFavorite {
  userId    Int
  quoteId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@id([userId, quoteId])
  @@index([quoteId])
  @@map("user_favorites")
}


// ============================================================
// Model: QuoteCategory
// Tabel relasi many-to-many antara Quote dan Category
// ============================================================
model QuoteCategory {
  quoteId    Int
  categoryId Int
  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([quoteId, categoryId])
  @@map("quote_categories")
}
